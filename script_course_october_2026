# Classify the point cloud using the PMF algorithm
classification1 <- classify_ground(las, algorithm = pmf(ws = 5, th = 3)) # Here, ws is the window size and th is the height threshold
transect <- clip_transect(classification1, p1, p2, width = 5)
ggplot(payload(transect), aes(X, Z, color = Classification)) +
  geom_point() +
  ggtitle("pmf") +
  theme_minimal() +
  scale_color_viridis_c(option = "viridis")




# Create progressive window sizes from 3 to 12, increasing by 3:
# this produces four values: 3, 6, 9, and 12
ws <- seq(3, 12, 3)
ws

# Create the same number of threshold values as window sizes,
# evenly spaced from 0.1 to 2. These values are approximately
# 0.1, 0.733, 1.367, and 2.
# Each threshold pairs with a window size in order.
th <- seq(0.1, 2, length.out = length(ws))
th

#and then we re-run the classification
classification2<-classify_ground(las, algorithm = pmf(ws=ws, th=th) )
transect<-clip_transect(classification2, p1, p2, width = 5)
ggplot(payload(transect), aes(X,Z, color=Classification  ) )+
  geom_point()+
  ggtitle("pmf_tuned")+
  theme_minimal()+
  scale_color_viridis_c(option="viridis")




